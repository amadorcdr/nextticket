# Variables de docker-compose.prod.yml
# ============================================================================
# Copiar a .env (mismo directorio) y rellenar. El .env NO se sube al repo.
#
#   cp .env.prod.example .env
#
# En la EC2 este archivo es lo único que cambia entre tu máquina y el servidor.
# ============================================================================

# ─── Base de datos ───────────────────────────────────────────────────────────
POSTGRES_USER=postgres
# En la EC2 cámbiala. La base no se expone a internet, pero si algún día se
# abre el puerto por error, "postgres" es la primera que alguien prueba.
POSTGRES_PASSWORD=postgres

# ─── JWT ─────────────────────────────────────────────────────────────────────
# El MISMO valor en los cinco servicios: el gateway y los microservicios
# validan los tokens que emite auth-service. Si no coincide, todo da 401.
# Generar uno largo con:  openssl rand -base64 48
JWT_SECRET=cambiame-por-un-secreto-largo-de-verdad
JWT_EXPIRES_IN=1d

# ─── Token interno servicio-a-servicio ────────────────────────────────────────
# El MISMO valor en venues-events-service, purchases-service y tickets-service:
# protege las llamadas internas entre ellos (emitir boleto al confirmar una
# compra, marcar asientos vendidos, y bloquear la cancelación de un evento con
# boletos vendidos). No es un JWT de usuario, es un secreto compartido fijo.
# Generar uno largo con:  openssl rand -base64 48
INTERNAL_SERVICE_TOKEN=cambiame-por-otro-secreto-compartido-largo

# ─── Admin inicial (bootstrap) ────────────────────────────────────────────────
# Se crea solo al primer arranque de auth-service, ÚNICAMENTE si todavía no
# existe ningún usuario con rol ADMIN — así puedes entrar por primera vez sin
# tener que crear el admin a mano por SQL. Cámbiala en cuanto inicies sesión.
SEED_ADMIN_EMAIL=admin@nextticket.com
SEED_ADMIN_PASSWORD=cambiame-por-una-contraseña-real

# ─── Frontend y API públicos ──────────────────────────────────────────────────
# FRONTEND_URL: URL pública del sitio (donde vive el navegador del usuario).
# Se usa para armar los enlaces de activación de cuenta y recuperación de
# contraseña, Y para el allowlist de CORS de los cuatro microservicios (el
# navegador manda el Origin de esta URL en cada petición, nunca el del
# api-gateway — por eso NO se usa GATEWAY_URL para el CORS).
# ⚠ CÁMBIALA. Si queda mal, los correos de activación/recuperación llevan a un
# sitio que no existe, Y todas las peticiones del navegador se bloquean por CORS.
FRONTEND_URL=https://cambia-esto.tu-dominio.com

# GATEWAY_URL: URL pública de LA API (no del frontend). Se usa para construir
# URLs que el navegador tiene que poder resolver directamente (p. ej. la
# imagen de portada de un evento) — NUNCA el hostname interno de Docker
# (http://api-gateway:3001), eso solo lo entienden los contenedores entre sí.
# ⚠ CÁMBIALA. Si queda mal, las imágenes subidas se guardan bien pero el
# navegador nunca puede cargarlas (ERR_NAME_NOT_RESOLVED).
GATEWAY_URL=https://api.cambia-esto.tu-dominio.com

# ─── Google OAuth (opcional) ─────────────────────────────────────────────────
# Si se dejan vacíos, el login con Google queda deshabilitado y el resto
# funciona igual. La URL de callback debe darse de alta en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ─── Correo (opcional) ───────────────────────────────────────────────────────
# Vacío = cuenta de prueba Ethereal automática; los correos no llegan a
# bandejas reales pero el log imprime un enlace para verlos.
SMTP_HOST=
SMTP_PORT=587
# false con el puerto 587 (STARTTLS); true solo con el 465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NextTicket <no-reply@nextticket.local>
