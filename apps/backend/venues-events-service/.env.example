# venues-events-service/.env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/venues_events_db?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3003
GATEWAY_URL=http://localhost:3001

# El MISMO valor en los 4 servicios: si no, los tokens que emite
# auth-service no se validan en los demás.
JWT_SECRET=cambiame-por-un-secreto-largo

# El MISMO valor en purchases-service y tickets-service: autentica
# POST /events/:eventId/seats/internal/mark-sold (lo llama purchases-service)
# y las llamadas salientes de este servicio a tickets-service (más abajo).
INTERNAL_SERVICE_TOKEN=cambiame-por-un-secreto-compartido-largo

# Para preguntarle a tickets-service cuántos boletos vendidos tiene un evento
# antes de dejarlo cancelar (GET /tickets/internal/sold-count).
TICKETS_SERVICE_URL=http://localhost:3005
