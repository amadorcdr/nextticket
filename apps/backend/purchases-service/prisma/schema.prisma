generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Purchase {
  id        String   @id @default(uuid())
  total     Decimal  @db.Decimal(11, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
