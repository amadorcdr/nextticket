# purchases-service/.env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/purchases_db?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3004
GATEWAY_URL=http://localhost:3001

# Para verificar que un ORGANIZER es dueño del evento que consulta en
# /purchases y /purchases/stats (venues-events-service expone GET /events/:id
# sin auth, así que basta un GET simple).
VENUES_EVENTS_URL=http://localhost:3003

# El MISMO valor en los 4 servicios: si no, los tokens que emite
# auth-service no se validan en los demás.
JWT_SECRET=cambiame-por-un-secreto-largo
