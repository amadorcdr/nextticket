# tickets-service/.env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tickets_db?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3005
GATEWAY_URL=http://localhost:3001

# Usado para verificar que un ticket pertenece al evento seleccionado antes
# de validarlo (POST /tickets/validations).
VENUES_EVENTS_URL=http://localhost:3003

# El MISMO valor en los 4 servicios: si no, los tokens que emite
# auth-service no se validan en los demás.
JWT_SECRET=cambiame-por-un-secreto-largo

QR_HASH_SECRET=cambiame-por-otro-secreto

# El MISMO valor en purchases-service y venues-events-service: autentica las
# llamadas internas POST /tickets/internal/issue-for-purchase y
# GET /tickets/internal/sold-count (no son JWT de usuario).
INTERNAL_SERVICE_TOKEN=cambiame-por-un-secreto-compartido-largo
