# tickets-service/.env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tickets_db?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3005
GATEWAY_URL=http://localhost:3001

# El MISMO valor en los 4 servicios: si no, los tokens que emite
# auth-service no se validan en los demás.
JWT_SECRET=cambiame-por-un-secreto-largo

QR_HASH_SECRET=cambiame-por-otro-secreto
