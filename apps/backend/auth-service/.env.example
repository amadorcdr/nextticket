# auth-service/.env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_db?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3002
GATEWAY_URL=http://localhost:3001

# El MISMO valor en los 4 servicios: si no, los tokens que emite
# auth-service no se validan en los demás.
JWT_SECRET=cambiame-por-un-secreto-largo
JWT_EXPIRES_IN=1d

# Admin que se crea solo al primer arranque (bootstrap): sin esto, una base
# nueva no tiene forma de crear un ADMIN por la API. Es un no-op en cuanto ya
# existe algún ADMIN, así que no hay riesgo de pisar contraseñas después.
# Cámbiala tras el primer login. Si se dejan vacías, cae en el default
# admin@nextticket.com / Admin123!
SEED_ADMIN_EMAIL=admin@nextticket.com
SEED_ADMIN_PASSWORD=Admin123!

# Credenciales de Google Cloud. NUNCA subas las reales al repositorio.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3002/auth/google/callback

# Base del frontend (webshell) para armar el enlace de activación de cuenta:
# ${FRONTEND_URL}/activate-account?token=...
FRONTEND_URL=http://localhost:4000

# Vigencia del enlace de activación de cuenta, en horas.
ACTIVATION_TOKEN_TTL_HOURS=48

# Vigencia del enlace de recuperación de contraseña, en minutos. Corta a
# propósito: a diferencia de la activación, aquí ya hay una cuenta activa
# en juego. ${FRONTEND_URL}/reset-password?token=...
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# SMTP para enviar correo real. Si se deja vacío, en local se usa una cuenta
# de prueba Ethereal automática (la URL de vista previa se imprime en el log).
# Con Gmail: SMTP_USER es la cuenta completa y SMTP_PASS es una "contraseña
# de aplicación" de 16 caracteres (myaccount.google.com/apppasswords), NUNCA
# la contraseña normal de la cuenta. NUNCA subas las reales al repositorio.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-contraseña-de-aplicación-16-chars
MAIL_FROM=NextTicket <tu-cuenta@gmail.com>
