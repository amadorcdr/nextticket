generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

/// Estado del flujo de registro/activación: PENDING = creado pero sin
/// contraseña propia todavía, ACTIVE = ya activó su cuenta (o vino de OAuth).
enum AccountStatus {
  PENDING
  ACTIVE
}

model User {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  createdBy     String?
  lastModifiedBy String?
  status        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  name          String
  email         String   @unique
  password      String?
  accountStatus AccountStatus @default(ACTIVE)
  roleId        String
  provider      String   @default("LOCAL")
  providerId    String?  @unique
  role          Role     @relation(fields: [roleId], references: [id])
}

model Role {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  createdBy      String?
  lastModifiedBy String?
  status         Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  name           String   @unique
  description    String?
  users          User[]
}
